---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostList from '@/components/PostList.astro';
import { getPosts } from '@/lib/posts';
import { links } from '@/config';

const posts = await getPosts();
---

<Base title="Writing" description="Articles I've published on Medium.">
  <PageHeader title="writing" lead="Articles I've published on Medium.">
    {links.medium && (
      <p class="mt-3 font-mono text-sm">
        <a href={links.medium} target="_blank" rel="noopener noreferrer">follow on medium <span aria-hidden="true">↗</span><span class="sr-only"> (new tab)</span></a>
      </p>
    )}
  </PageHeader>
  <PostList posts={posts} headingLevel="h2" />
</Base>
