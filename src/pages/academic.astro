---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getEducation } from '@/lib/content';
import { formatPeriod } from '@/lib/format';

const education = await getEducation();
---

<Base title="Academic" description="Degrees, qualifications and where I studied.">
  <PageHeader title="academic" lead="Where I studied and what I earned along the way." />

  {
    education.length === 0 ? (
      <p class="text-muted">Nothing here yet.</p>
    ) : (
      <ol class="relative ml-1 border-l border-line">
        {education.map(({ data }) => (
          <li class="relative pb-12 pl-7 last:pb-0">
            <span
              class:list={[
                'absolute -left-[5px] top-[0.45rem] size-[9px] rounded-full border',
                data.end ? 'border-line bg-bg' : 'border-accent bg-accent',
              ]}
              aria-hidden="true"
            />
            <p class="font-mono text-xs text-muted tabular-nums">
              <time datetime={data.start}>{formatPeriod(data.start)}</time> –{' '}
              {data.end ? <time datetime={data.end}>{formatPeriod(data.end)}</time> : <span class="text-accent">present</span>}
            </p>
            <h2 class="mt-1.5 text-lg font-semibold leading-snug">{data.qualification}</h2>
            <p class="text-sm text-muted">
              {data.institutionUrl ? <a href={data.institutionUrl} target="_blank" rel="noopener noreferrer">{data.institution}</a> : data.institution}
              {data.location && <span> · {data.location}</span>}
            </p>
            {data.grade && <p class="mt-2 font-mono text-xs text-accent">{data.grade}</p>}
            {data.highlights.length > 0 && (
              <ul class="mt-4 space-y-2 text-[0.9375rem]">
                {data.highlights.map((h) => (
                  <li class="relative pl-5">
                    <span class="absolute left-0 text-accent" aria-hidden="true">–</span>
                    {h}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    )
  }
</Base>
