---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import TagList from '@/components/TagList.astro';
import ProjectAffiliation from '@/components/ProjectAffiliation.astro';
import { getProjects } from '@/lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((p) => p.body?.trim())
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, tags, github, live } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={description} type="article">
  <p class="mb-10 font-mono text-sm"><a href="/projects" class="no-underline text-muted hover:text-accent"><span aria-hidden="true">← </span>projects</a></p>
  <article>
    <header class="mb-10 border-b border-line pb-8">
      <ProjectAffiliation company={project.data.company} companyUrl={project.data.companyUrl} class="mb-2" />
      <h1 class="font-mono text-2xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 text-muted">{description}</p>
      <TagList tags={tags} class="mt-5" />
      {
        (github || live) && (
          <ul class="mt-5 flex gap-5 font-mono text-sm">
            {github && <li><a href={github} target="_blank" rel="noopener noreferrer">source <span aria-hidden="true">↗</span><span class="sr-only"> (GitHub, new tab)</span></a></li>}
            {live && <li><a href={live} target="_blank" rel="noopener noreferrer">live site <span aria-hidden="true">↗</span><span class="sr-only"> (new tab)</span></a></li>}
          </ul>
        )
      }
    </header>
    <div class="prose-body">
      <Content />
    </div>
  </article>
</Base>
