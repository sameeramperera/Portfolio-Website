---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
---

<Base title="Projects" description="Things I've built: side projects, tools and experiments.">
  <PageHeader title="projects" lead="Things I've built, from side projects to small tools and experiments." />
  <div class="grid gap-4">
    {projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
  </div>
</Base>
