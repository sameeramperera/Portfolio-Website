---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, profile } from '@/config';

interface Props {
  /** Page title. The site name is appended automatically (except on the home page). */
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a 1200×630 image. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description = site.description, image = '/og.png', type = 'website', noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${profile.name}` : site.title;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme: runs before first paint so there is no flash of the wrong theme. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const media = matchMedia('(prefers-color-scheme: dark)');
        const apply = (dark) => {
          root.classList.toggle('dark', dark);
          root.classList.toggle('light', !dark);
        };
        apply(stored ? stored === 'dark' : media.matches);
        // Follow OS changes until the visitor makes an explicit choice.
        media.addEventListener('change', (e) => {
          let s = null;
          try { s = localStorage.getItem('theme'); } catch {}
          if (!s) apply(e.matches);
        });
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1113" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-bg focus:px-3 focus:py-2 focus:font-mono focus:text-sm"
    >
      Skip to content
    </a>
    <div class="mx-auto flex min-h-dvh max-w-[680px] flex-col px-5 sm:px-6">
      <Header />
      <main id="main" class="flex-1 pb-24 pt-10 sm:pt-16">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
