---
import ThemeToggle from './ThemeToggle.astro';
import { nav, profile } from '@/config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-line py-5">
  <a href="/" class="font-mono text-sm font-semibold no-underline text-fg hover:text-accent">
    <span class="text-accent" aria-hidden="true">~/</span>{profile.name.toLowerCase().replace(/\s+/g, '-')}
  </a>
  <!-- Mobile: logo + toggle on the first row, nav on its own row. sm+: everything on one row. -->
  <div class="contents sm:flex sm:items-center sm:gap-5">
    <nav aria-label="Main" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-[0.8125rem] sm:gap-x-4">
        {
          nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'no-underline',
                  isActive(href) ? 'text-accent' : 'text-muted hover:text-fg',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
