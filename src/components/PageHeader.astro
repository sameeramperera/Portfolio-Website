---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="mb-14">
  <h1 class="font-mono text-2xl font-semibold tracking-tight">
    <span class="text-accent" aria-hidden="true">/</span>{title}
  </h1>
  {lead && <p class="mt-3 text-muted">{lead}</p>}
  <slot />
</header>
